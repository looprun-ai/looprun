+/** The vessel a call names is on the register and no freeze stands over her. A row reaches
+ *  a gate without its own key, so the key is the one this same snapshot files that row
+ *  under — the gate and the snapshot hold one object, and identity gives the key back. */
+const vesselIsFree = (record: Readonly<Record<string, unknown>> | null,
+  state: StateSnapshot): boolean => {
+  if (record === null) return false;
+  const standing = Object.values(state['holds'] ?? {}).filter(hold => hold?.['active'] === true);
+  if (standing.some(hold => hold['scope'] === 'harbor')) return false;
+  const key = Object.entries(state['vessels'] ?? {})
+    .find(([, row]) => row === record)?.[0];
+  return key === undefined
+    || !standing.some(hold => hold['scope'] === 'vessel' && hold['vesselId'] === key);
+};
