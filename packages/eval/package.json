{
  "name": "@looprun-ai/eval",
  "version": "0.20.0",
  "type": "module",
  "description": "looprun eval: verbs over a run directory. Load a subject, validate it, run its cases governed or ungoverned, scan the dumps for incidents, build blind judge inputs, fold the verdicts back, certify against a bar and seal the authored subject. The run directory is the only state — there is nothing to resume.",
  "keywords": [
    "ai",
    "agents",
    "llm",
    "governance",
    "guardrails",
    "agentspec",
    "evals",
    "certification",
    "judge"
  ],
  "license": "Apache-2.0",
  "author": "LoopRun Team",
  "homepage": "https://looprun.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/looprun-ai/looprun.git",
    "directory": "packages/eval"
  },
  "bugs": {
    "url": "https://github.com/looprun-ai/looprun/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "gate": "tsc --noEmit && eslint . && vitest run --passWithNoTests"
  },
  "dependencies": {
    "@looprun-ai/core": "workspace:^",
    "@looprun-ai/mastra": "workspace:^",
    "typescript": "^5.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
