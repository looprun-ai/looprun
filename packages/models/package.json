{
  "name": "@looprun-ai/models",
  "version": "0.20.0",
  "type": "module",
  "description": "looprun model story: the validated local tiers on llama.cpp behind a ModelRuntimePort, with the measured serving flags per tier and a downloader that asks before it pulls gigabytes.",
  "keywords": [
    "ai",
    "agents",
    "llm",
    "governance",
    "guardrails",
    "agentspec",
    "llama.cpp",
    "local-llm",
    "gguf"
  ],
  "license": "Apache-2.0",
  "author": "LoopRun Team",
  "homepage": "https://looprun.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/looprun-ai/looprun.git",
    "directory": "packages/models"
  },
  "bugs": {
    "url": "https://github.com/looprun-ai/looprun/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "gate": "tsc --noEmit && eslint . && vitest run --passWithNoTests"
  },
  "dependencies": {
    "@looprun-ai/core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
