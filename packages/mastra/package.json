{
  "name": "@looprun-ai/mastra",
  "version": "0.20.0",
  "type": "module",
  "description": "looprun on Mastra: LoopRunAgent IS a @mastra/core Agent built from the two cards and a world, so `new Mastra({ agents })` and generate/stream work unchanged while every destructive call passes through consent. UngovernedAgent is the same agent with every guard hook empty — the twin a measurement compares against.",
  "keywords": [
    "ai",
    "agents",
    "llm",
    "governance",
    "guardrails",
    "agentspec",
    "mastra",
    "agent"
  ],
  "license": "Apache-2.0",
  "author": "LoopRun Team",
  "homepage": "https://looprun.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/looprun-ai/looprun.git",
    "directory": "packages/mastra"
  },
  "bugs": {
    "url": "https://github.com/looprun-ai/looprun/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "gate": "tsc --noEmit && eslint . && vitest run --passWithNoTests"
  },
  "dependencies": {
    "@looprun-ai/core": "workspace:^",
    "@mastra/core": "^1.42.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ai": "^6.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
