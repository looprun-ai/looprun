{
  "name": "@looprun-ai/server",
  "version": "0.20.0",
  "type": "module",
  "description": "looprun model server: a governed agent behind an OpenAI-compatible /v1/chat/completions endpoint, so any harness that speaks the OpenAI protocol talks to it as if it were a model. One request carries one whole governed turn — guards, consent and all — and returns the final assistant message.",
  "keywords": [
    "ai",
    "agents",
    "llm",
    "governance",
    "guardrails",
    "agentspec",
    "openai-compatible",
    "model-server"
  ],
  "license": "Apache-2.0",
  "author": "LoopRun Team",
  "homepage": "https://looprun.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/looprun-ai/looprun.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/looprun-ai/looprun/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "gate": "tsc --noEmit && eslint . && vitest run --passWithNoTests"
  },
  "dependencies": {
    "@looprun-ai/core": "workspace:^",
    "@looprun-ai/mastra": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
